DB_URL=postgresql://user:password@host/dbname?sslmode=require
BEARER_TOKEN_X=
NEWS_API_KEY=
# Explicit origins, never `*`: the API answers with credentials, and a
# wildcard is refused by browsers in that case. Production adds the app's
# origin here — https://meetyourleader.in — alongside the dev ones.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
REDIS_URL=
# The Google OAuth client. CLIENT_ID is public — the browser needs the same
# value in web/.env.local as NEXT_PUBLIC_GOOGLE_CLIENT_ID for the Sign in with
# Google popup. CLIENT_SECRET stays here, server-side, and never goes near the
# frontend. Google Cloud console: the popup flow needs this app's origins under
# "Authorised JavaScript origins"; no redirect URI is required.
CLIENT_ID=
CLIENT_SECRET=
# Production: https://meetyourleader.in
# Comma-separated is accepted (e.g. while two domains are live). Every entry is
# validated at startup; the first is the canonical one. This does NOT authorise
# browser requests — CORS_ORIGINS above does that.
FRONTEND_URL=http://localhost:3000

# Production: COOKIE_SECURE=true, COOKIE_SAMESITE=lax.
#
# The app (meetyourleader.in) and the API (api.meetyourleader.in) are different
# origins but the same *site*, so the session cookies are first-party and ride
# along with `lax`. That is the whole point of the domain layout: `none` marks
# them third-party, which Safari blocks by default — sign in, and be signed out
# again on the next request.
#
# No `Domain` attribute is set anywhere. The cookies are host-only on the API,
# which is the only thing that reads them; widening them to
# `.meetyourleader.in` would hand them to the app host for no reason.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
DATA_UPDATED_AT=2026-07-30
