DB_URL=postgresql://user:password@host/dbname?sslmode=require
BEARER_TOKEN_X=
NEWS_API_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
REDIS_URL=
# The Google OAuth client. CLIENT_ID is public — the browser needs the same
# value in web/.env.local as NEXT_PUBLIC_GOOGLE_CLIENT_ID for the Sign in with
# Google popup. CLIENT_SECRET stays here, server-side, and never goes near the
# frontend. Google Cloud console: the popup flow needs this app's origins under
# "Authorised JavaScript origins"; no redirect URI is required.
CLIENT_ID=
CLIENT_SECRET=
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false
# lax | strict | none. Use `none` (with COOKIE_SECURE=true) when the app and
# API are on hosts that are different sites, e.g. *.up.railway.app.
COOKIE_SAMESITE=lax
DATA_UPDATED_AT=2026-07-30
